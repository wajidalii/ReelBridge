# --- General -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS + CSRF origin check).
CLIENT_ORIGIN=http://localhost:5173
# Behind a reverse proxy / load balancer: hop count (e.g. 1) or a CIDR. Leave
# unset when the API is reached directly.
TRUST_PROXY=
# Structured logging: trace|debug|info|warn|error. LOG_PRETTY=true for human-readable output.
LOG_LEVEL=info
LOG_PRETTY=true
# Set CRON_ENABLED=false on all but one API replica if you'd rather not have
# every replica run the enqueue-only sweeps (they're safe to run everywhere).
CRON_ENABLED=true
# Optional bearer token required to scrape /api/metrics (API) and :4001/metrics (worker).
METRICS_BEARER_TOKEN=
WORKER_METRICS_PORT=4001

# --- Postgres ------------------------------------------------------------------
DATABASE_URL=postgres://reelbridge:reelbridge@localhost:5432/reelbridge

# --- Redis / BullMQ --------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (MinIO locally, S3/R2 in production) -----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reelbridge-media
S3_ACCESS_KEY_ID=reelbridge
S3_SECRET_ACCESS_KEY=reelbridge123
S3_FORCE_PATH_STYLE=true

# --- Secrets (generate distinct random values for each — never reuse) -----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
JWT_SECRET=

# --- Early-access gating (issue #40) ------------------------------------------
# open | invite. In invite mode a signup needs a code from SIGNUP_INVITE_CODES
# or an email under SIGNUP_ALLOWED_EMAIL_DOMAINS (both comma-separated).
SIGNUP_MODE=open
SIGNUP_INVITE_CODES=
SIGNUP_ALLOWED_EMAIL_DOMAINS=
# Flip to true once each external review clears; drives the client's gating copy.
META_APP_REVIEW_APPROVED=false
YOUTUBE_COMPLIANCE_APPROVED=false

# --- Transactional email (issue #38) ------------------------------------------
# console (logs the email, dev default) | resend | memory (tests)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="ReelBridge <no-reply@example.com>"

# --- Billing enforcement (issue #43 groundwork) --------------------------------
# Plan limits (plans.max_targets / max_posts_per_month) are only enforced when true.
PLAN_LIMITS_ENFORCED=false

# --- Rate limits / tuning ---------------------------------------------------------
AUTH_RATE_LIMIT_PER_15M=20
API_RATE_LIMIT_PER_MINUTE=300
UPLOAD_RATE_LIMIT_PER_HOUR=60
MEDIA_MAX_FILE_SIZE_BYTES=524288000
DATABASE_POOL_MAX=10
# DATABASE_SSL=true for managed Postgres that requires TLS.
DATABASE_SSL=false
APP_MANAGED_PUBLISH_LATE_THRESHOLD_MINUTES=5

# --- Meta (Facebook + Instagram) OAuth -------------------------------------------
FB_APP_ID=
FB_APP_SECRET=
# Defaults to {API_BASE_URL}/api/connections/facebook/callback if unset.
FB_OAUTH_REDIRECT_URI=
API_BASE_URL=http://localhost:4000

# --- Google (YouTube) OAuth -------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {API_BASE_URL}/api/connections/google/callback if unset.
GOOGLE_OAUTH_REDIRECT_URI=
